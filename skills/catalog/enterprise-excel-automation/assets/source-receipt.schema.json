{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:offline-tools:enterprise-excel:source-receipt:1",
  "type": "object",
  "required": ["schema_version", "run_id", "source", "captured_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "modified_at_utc": {"type": ["string", "null"]},
        "read_only": {"type": ["boolean", "null"]},
        "file_format": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "access_path": {"enum": ["direct", "trusted-office-compatibility", "not-accessible"]},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
