{
  "schemaVersion": 6,
  "policy": {
    "targetInternetMode": "ai-services-only",
    "targetDownloadsAllowed": false,
    "targetExtensionMarketplaceAllowed": false,
    "targetPackageRegistryAllowed": false,
    "targetSelfUpdatesAllowed": false,
    "localModelsAllowed": false,
    "bashAllowed": true,
    "bashRequired": false,
    "bashDefaultShell": false,
    "bashFallbackBundled": true,
    "wslAllowed": false,
    "allowedShells": ["powershell7", "windows-powershell", "cmd", "git-bash-fallback"],
    "allInstallArtifactsMustBePrebundled": true,
    "disableTlsVerificationAllowed": false,
    "useWindowsCertificateStoreForNode": true
  },
  "core": {
    "vscode": {
      "channel": "stable",
      "architecture": "x64",
      "archiveUrl": "https://update.code.visualstudio.com/latest/win32-x64-archive/stable",
      "portable": true
    },
    "powershell": {
      "distribution": "PowerShell 7",
      "releaseApi": "https://api.github.com/repos/PowerShell/PowerShell/releases/latest",
      "assetRegex": "^PowerShell-[0-9.]+-win-x64\\.zip$",
      "portable": true
    },
    "git": {
      "distribution": "MinGit for Windows",
      "architecture": "x64",
      "releaseApi": "https://api.github.com/repos/git-for-windows/git/releases/latest",
      "assetRegex": "^MinGit-.*-64-bit\\.zip$",
      "bashRequired": false,
      "portableBashAssetRegex": "^PortableGit-.*-64-bit\\.7z\\.exe$",
      "portableBash": true,
      "portableBashPurpose": "Isolated compatibility fallback for tools that explicitly require Git Bash. It is never the default shell and is not placed directly on machine PATH."
    },
    "gitea": {
      "version": "1.27.0",
      "file": "gitea-1.27.0-windows-4.0-amd64.exe",
      "url": "https://dl.gitea.com/gitea/1.27.0/gitea-1.27.0-windows-4.0-amd64.exe",
      "database": "sqlite3",
      "listen": "127.0.0.1",
      "preferredPort": 13080,
      "portSearchEnd": 13100,
      "offlineMode": true
    }
  },
  "aiCli": [
    { "name": "Codex CLI", "package": "@openai/codex", "command": "codex", "supported": true },
    { "name": "Claude Code CLI", "package": "@anthropic-ai/claude-code", "command": "claude", "supported": true, "requiresGitBash": true },
    { "name": "Cline CLI", "package": "cline", "command": "cline", "supported": true },
    { "name": "Kilo CLI", "package": "@kilocode/cli", "command": "kilo", "supported": true },
    { "name": "OpenCode CLI", "package": "opencode-ai", "command": "opencode", "supported": true }
  ],
  "conditionalShellTools": [
    {
      "name": "Claude Code",
      "condition": "Portable Git Bash must be allowed to execute by corporate application-control policy.",
      "fallbackBehavior": "If Bash execution is blocked, Claude Code is marked unavailable while the rest of the suite remains operational."
    }
  ],
  "nodeCli": [
    "pnpm",
    "yarn",
    "typescript",
    "tsx",
    "eslint",
    "prettier",
    "@vscode/vsce",
    "node-gyp@13.0.1"
  ],
  "vscodeExtensionsCore": [
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-python.debugpy",
    "ms-toolsai.jupyter",
    "ms-vscode.powershell",
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode",
    "eamodio.gitlens"
  ],
  "vscodeExtensionsAi": [
    "OpenAI.chatgpt",
    "anthropic.claude-code",
    "saoudrizwan.claude-dev",
    "kilocode.Kilo-Code",
    "sst-dev.opencode"
  ],
  "desktopApps": [
    {
      "name": "OpenCode Desktop",
      "supported": true,
      "source": "github-release",
      "releaseApi": "https://api.github.com/repos/anomalyco/opencode/releases/latest",
      "assetPattern": "opencode-desktop-windows-x64.exe"
    },
    {
      "name": "ChatGPT Desktop with Codex",
      "supported": true,
      "source": "enterprise-offline-payload",
      "payloadPath": "payload/developer/desktop/chatgpt"
    },
    {
      "name": "Claude Desktop",
      "supported": true,
      "source": "offline-payload",
      "payloadPath": "payload/developer/desktop/claude"
    },
    {
      "name": "Kilo Desktop",
      "supported": false,
      "replacement": "Kilo Console local browser UI"
    },
    {
      "name": "Cline Desktop",
      "supported": false,
      "replacement": "Cline VS Code extension and CLI"
    }
  ]
}
